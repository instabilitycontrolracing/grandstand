<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2026-10-30 (#601): broadcast theme previews (4K stills / clips over a procedural trackside picture), the Default
       pixel check and the per-frame theme bench, drawn by the REAL renderers. Runs against the BUILT app assemblies (GsBin,
       default the GpuHost Release output). OldBuild=1 compiles only the pixel check, for assemblies from before #601.
       Not part of the app build. See run.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GsBin Condition="'$(GsBin)' == ''">$(MSBuildThisFileDirectory)../../src/ApexHUD.Native.GpuHost/bin/Release/net8.0-windows</GsBin>
    <DefineConstants Condition="'$(OldBuild)' == '1'">$(DefineConstants);OLDBUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ApexHUD.Native.Overlays"><HintPath>$(GsBin)/ApexHUD.Native.Overlays.dll</HintPath></Reference>
    <Reference Include="ApexHUD.Native.Common"><HintPath>$(GsBin)/ApexHUD.Native.Common.dll</HintPath></Reference>
    <Reference Include="ApexHUD.Native.Data"><HintPath>$(GsBin)/ApexHUD.Native.Data.dll</HintPath></Reference>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>
</Project>

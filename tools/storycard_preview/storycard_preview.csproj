<Project Sdk="Microsoft.NET.Sdk">
  <!-- 2026-10-27 (#349): offline renders of the REAL story cards (StoryCards) in each card layout - classic and the
       four right-third layouts (column / halves / flip / corners) - over a mock TV frame with the centre third marked,
       plus a contact sheet per layout and a per-frame allocation check. Runs against the BUILT app assemblies (GsBin,
       default the GpuHost Release output). See run.sh / run.ps1. Not part of the app build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <GsBin Condition="'$(GsBin)' == ''">$(MSBuildThisFileDirectory)../../src/ApexHUD.Native.GpuHost/bin/Release/net8.0-windows</GsBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ApexHUD.Native.Overlays"><HintPath>$(GsBin)/ApexHUD.Native.Overlays.dll</HintPath></Reference>
    <Reference Include="ApexHUD.Native.Common"><HintPath>$(GsBin)/ApexHUD.Native.Common.dll</HintPath></Reference>
    <Reference Include="ApexHUD.Native.Data"><HintPath>$(GsBin)/ApexHUD.Native.Data.dll</HintPath></Reference>
    <Compile Include="../stinger_bench/Egl.cs" />   <!-- headless OpenGL for the pit-card bench -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>
</Project>
